package main

import (
	"fmt"
	"os"
	"os/exec"
	"time"
)
type RootDNSServer struct {
	IP        string
	Port      int
	CacheSize int
}
func (s RootDNSServer) StartServer() {
	fmt.Printf("[*] Launching Root Node Engine via Struct Method...\n")
	fmt.Printf("[->] Binding to Network IP: %s\n", s.IP)
	fmt.Printf("[->] Opening UDP Port: %d\n", s.Port)
	fmt.Printf("[->] Loading In-Memory Trie Cache: %d records\n", s.CacheSize)
	time.Sleep(1 * time.Second)
	fmt.Println("\n[!!!] SUCCESS: PROJECT TIGER ROOT DNS SERVER IS NOW LIVE !!!")
}
func main() {
	cmd := exec.Command("clear")
	cmd.Stdout = os.Stdout
	cmd.Run()

	fmt.Println("=========================================")
	fmt.Println("[+] Y4: PROJECT TIGER - STRUCT METHODS   ")
	fmt.Println("=========================================")

	myServer := RootDNSServer{
		IP:        "127.0.0.1",
		Port:         5300,
		CacheSize: 500000,
	}
	myServer.StartServer()

	fmt.Println("=========================================")
}
