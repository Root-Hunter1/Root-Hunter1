import random
import string
import os

# Character sets
uppercase = string.ascii_uppercase  # A-Z
lowercase = string.ascii_lowercase  # a-z
digits = string.digits              # 0-9
special = string.punctuation        # !@#$%^&*...

def get_password_length():
    """Password length user থেকে নিন"""
    while True:
        try:
            length = int(input("\n[+] Enter password length (min 6): ").strip())
            if length < 6:
                print("[!] Error: Minimum length is 6")
                continue
            return length
        except ValueError:
            print("[!] Error: Enter a valid number")

def get_character_options():
    """Character types user থেকে নিন"""
    options = {}
    
    print("\n[+] Choose character types:")
    print("_" * 50)
    
    options['uppercase'] = input("[?] Include Uppercase Letters (A-Z)? (yes/no): ").lower().strip() in ['yes', 'y']
    options['lowercase'] = input("[?] Include Lowercase Letters (a-z)? (yes/no): ").lower().strip() in ['yes', 'y']
    options['digits'] = input("[?] Include Numbers (0-9)? (yes/no): ").lower().strip() in ['yes', 'y']
    options['special'] = input("[?] Include Special Characters (!@#...)? (yes/no): ").lower().strip() in ['yes', 'y']
    
    # কম্পক্ষে 1টি option select হয়েছে কি?
    if not any(options.values()):
        print("\n[!] Error: Please select at least one option")
        return get_character_options()
    
    return options

def generate_password(length, options):
    """Password generate করুন"""
    available_chars = ""
    
    if options['uppercase']:
        available_chars += uppercase
    if options['lowercase']:
        available_chars += lowercase
    if options['digits']:
        available_chars += digits
    if options['special']:
        available_chars += special
    
    # Random password তৈরি করুন
    password = ''.join(random.choice(available_chars) for _ in range(length))
    return password

def check_password_strength(password, options):
    """Password strength check করুন"""
    score = 0
    checks = {}
    
    # Length check
    if len(password) >= 8:
        score += 1
        checks['length'] = True
    else:
        checks['length'] = False
    
    # Uppercase check
    if options['uppercase'] and any(c.isupper() for c in password):
        score += 1
        checks['uppercase'] = True
    else:
        checks['uppercase'] = False
    
    # Lowercase check
    if options['lowercase'] and any(c.islower() for c in password):
        score += 1
        checks['lowercase'] = True
    else:
        checks['lowercase'] = False
    
    # Numbers check
    if options['digits'] and any(c.isdigit() for c in password):
        score += 1
        checks['numbers'] = True
    else:
        checks['numbers'] = False
    
    # Special check
    if options['special'] and any(c in special for c in password):
        score += 1
        checks['special'] = True
    else:
        checks['special'] = False
    
    # Strength decide করুন
    if score >= 4:
        strength = "STRONG ✅"
    elif score >= 2:
        strength = "MEDIUM ⚠️"
    else:
        strength = "WEAK ❌"
    
    return strength, checks

def display_password_info(password, strength, checks):
    """Password information display করুন"""
    print("\n" + "=" * 50)
    print(f"[+] Generated Password: {password}")
    print(f"[+] Password Strength: {strength}")
    print("\n[+] Password Analysis:")
    print(f"   - Length: {len(password)} characters")
    print(f"   - Has Uppercase: {'Yes ✅' if checks['uppercase'] else 'No ❌'}")
    print(f"   - Has Lowercase: {'Yes ✅' if checks['lowercase'] else 'No ❌'}")
    print(f"   - Has Numbers: {'Yes ✅' if checks['numbers'] else 'No ❌'}")
    print(f"   - Has Special Characters: {'Yes ✅' if checks['special'] else 'No ❌'}")
    print("=" * 50)

def main():
    """Main program"""
    os.system("clear")
    print("=" * 50)
    print("[+] 🔐 SECURE PASSWORD GENERATOR 🔐")
    print("=" * 50)
    
    while True:
        try:
            # Step 1: Length নিন
            length = get_password_length()
            
            # Step 2: Options নিন
            options = get_character_options()
            
            # Step 3: Password generate করুন
            password = generate_password(length, options)
            
            # Step 4: Strength check করুন
            strength, checks = check_password_strength(password, options)
            
            # Step 5: Display করুন
            display_password_info(password, strength, checks)
            
            # Again?
            again = input("\n[?] Generate another password? (yes/no): ").lower().strip()
            if again not in ['yes', 'y']:
                print("\n[+] Thank you for using Secure Password Generator!")
                print("[+] Goodbye! 👋\n")
                break
            
        except KeyboardInterrupt:
            print("\n\n[!] Program interrupted by user")
            break
        except Exception as e:
            print(f"[!] An error occurred: {e}")
            continue

# Program চালান
if __name__ == "__main__":
    main()
