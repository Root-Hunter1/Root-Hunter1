import os

os.system("clear")
print("=" * 50)
print("[+] Y4 PROJECT: TIGER PYTHON CALCULATOR v2.0")
print("=" * 50)

history = []  # অপারেশন history সংরক্ষণের জন্য

while True:  # বারবার চলার জন্য loop
    try:
        num1 = float(input("\n[+] Enter First Number: ").strip())
        num2 = float(input("[+] Enter Second Number: ").strip())

        print("\n[+] Choose Mathematical Operation:")
        print("_" * 50)
        print(" [1] Addition (+)")
        print(" [2] Subtraction (-)")
        print(" [3] Multiplication (*)")
        print(" [4] Division (/)")
        print(" [5] Modulo (%)")
        print(" [6] Power (**)")
        print("_" * 50)

        choice = input("\n[*] Select Operation (1-6): ").strip()

        result = None
        operation_symbol = ""

        if choice == "1":
            result = num1 + num2
            operation_symbol = "+"
            print(f"\n[+] Addition Result: {num1} + {num2} = {result}")

        elif choice == "2":
            result = num1 - num2
            operation_symbol = "-"
            print(f"\n[-] Subtraction Result: {num1} - {num2} = {result}")

        elif choice == "3":
            result = num1 * num2
            operation_symbol = "*"
            print(f"\n[*] Multiplication Result: {num1} * {num2} = {result}")

        elif choice == "4":
            if num2 == 0:
                print("\n[!] Critical Error: Division by Zero is Illegal!")
                continue
            result = num1 / num2
            operation_symbol = "/"
            print(f"\n[/] Division Result: {num1} / {num2} = {result}")

        elif choice == "5":
            if num2 == 0:
                print("\n[!] Critical Error: Modulo by Zero is Illegal!")
                continue
            result = num1 % num2
            operation_symbol = "%"
            print(f"\n[%] Modulo Result: {num1} % {num2} = {result}")

        elif choice == "6":
            result = num1 ** num2
            operation_symbol = "**"
            print(f"\n[**] Power Result: {num1} ** {num2} = {result}")

        else:
            print("\n[!] Error: Invalid Operation Selection")
            continue

        # History তে যোগ করুন
        if result is not None:
            history.append(f"{num1} {operation_symbol} {num2} = {result}")

        # আরও করবেন?
        again = input("\n[?] Do you want to continue? (yes/no): ").strip().lower()
        if again in ["no", "n", "না"]:
            print("\n" + "=" * 50)
            print("[+] CALCULATION HISTORY:")
            print("=" * 50)
            for i, calc in enumerate(history, 1):
                print(f"[{i}] {calc}")
            print("\n[+] Thanks for using Tiger Calculator! Goodbye!")
            print("=" * 50)
            break

    except ValueError:
        print("\n[!] Input Error: Please enter valid numbers only")
        continue

    except Exception as e:
        print(f"\n[!] System Error: {e}")
        continue
