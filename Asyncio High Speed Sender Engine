import asyncio
import time

SERVER_IP = "127.0.1.0"
SERVER_PORT = 5353

class AsyncStressClient(asyncio.DatagramProtocol):
    def __init__(self, total_reqs):
        self.total_reqs = total_reqs
        self.response_count = 0
        self.transport = None

    def connection_made(self, transport):
        self.transport = transport

    def datagram_received(self, data, addr):
        self.response_count += 1
        print(f"[+] [Resp {self.response_count}] From {addr}: {data.decode(errors='ignore')}")

    def error_received(self, exc):
        print(f"[-] Socket error: {exc}")

async def send_packet(transport, payload):
    transport.sendto(payload)

async def main():
    print("=" * 60)
    print(f"[*] Starting High-Speed Stress Test to {SERVER_IP}:{SERVER_PORT}")
    print("=" * 60)

    total_requests = 1000 
    
    loop = asyncio.get_running_loop()
    transport, protocol = await loop.create_datagram_endpoint(
        lambda: AsyncStressClient(total_requests),
        remote_addr=(SERVER_IP, SERVER_PORT)
    )
    mock_dns_payload = bytes([0xAA, 0xBB]) + b"\x00\x01\x00\x00"
    
    start_time = time.time()

    tasks = [send_packet(transport, mock_dns_payload) for _ in range(total_requests)]
    await asyncio.gather(*tasks)
    
    await asyncio.sleep(2.0)
    
    duration = time.time() - start_time - 2.0
    print("=" * 60)
    print(f"[+] Load Test Finished Successfully!")
    print(f"[+] Packets Sent: {total_requests}")
    print(f"[+] Responses Received: {protocol.response_count} / {total_requests}")
    print(f"[+] Performance Duration: {duration:.4f} seconds")
    print("=" * 60)
    
    transport.close()

if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        print("\n[-] Testing interrupted by user.")

